<div class="container mx-auto max-w-screen-md">
  <%= form_for @changeset, @action, [as: :user, class: "max-w-sm  p-4 mt-6"], fn f -> %>
    <h1 class="text-2xl font-bold">Login</h1>
    <%= if @changeset.action do %>
      <div class="font-medium text-red-500">
        <p>Something went wrong, please check the errors below.</p>
      </div>
    <% end %>

    <%= label f, Pow.Ecto.Schema.user_id_field(@changeset), class: "block mt-6 font-medium" %>
    <%= email_input f, Pow.Ecto.Schema.user_id_field(@changeset), class: "block w-full", autofocus: true %>
    <%= error_tag f, Pow.Ecto.Schema.user_id_field(@changeset) %>

    <%= label f, :password, class: "block mt-6 font-medium" %>
    <%= password_input f, :password, class: "block w-full" %>
    <%= error_tag f, :password %>

    <div class="mt-4 flex flex-row justify-between items-center">
      <%= link "Forgot your password?", to: Routes.pow_reset_password_reset_password_path(@conn, :new), class: "text-sm underline" %>
      <%= submit "Login", class: "px-4 py-3 text-lg font-medium text-white bg-[#0000dd] rounded" %>
    </div>
  <% end %>
</div>
