<div class="container mx-auto max-w-screen-md">
  <h2 class="text-4xl mt-12 font-bold">$1/mo</h2>
  <h3 class="italic mt-4 text-lg">$12 billed annually</h3>
  <ul class="ml-4 mt-12 list-disc list-inside text-lg">
    <li>Try it <span class="text-emerald-500">free for a month</span> <span class="italic">(4 newsletters)</span></li>
    <li>We will send you a reminder when your trial ends</li>
    <li><span class="text-emerald-500">No credit card</span> required</li>
  </ul>

  <div class="flex justify-center items-center mt-8">
    <.link href={~p"/sample"} class="font-bold underline">
      See a sample
    </.link>
    <span class="mx-4 font-light">or</span>
    <.link href={~p"/u/create"} class="px-4 py-3 my-8 block text-lg font-medium text-white bg-[#0000dd] rounded">
      Get Started
    </.link>
  </div>
</div>
